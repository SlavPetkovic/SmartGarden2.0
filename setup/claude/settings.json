{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "$comment": [
    "Permission envelope for unattended runs. Intent is documented in",
    "docs/git-workflow.md (repository authority) and docs/BUILD-PLAN.md section 3",
    "(what a build run may do). The rules below enforce most of it mechanically;",
    "those documents hold where a rule has a gap.",
    "",
    "Changed 2026-09-08: git authority granted. Claude Code now pushes, opens",
    "pull requests and merges to main on green CI. The reviewer it replaced is",
    "the required status checks -- see .github/workflows/ and scripts/gate.py.",
    "What stays denied is what protects the running garden and the history:",
    "sudo, service control, force-pushing main, and merging past a red check.",
    "",
    "Changed 2026-09-08 (later): added $schema for editor validation; set",
    "includeCoAuthoredBy=false and cleanupPeriodDays=30 explicitly; widened the",
    "allow list to the bare tool names the gate uses (ruff, mypy, pytest,",
    "unittest, pip install, scripts/*.py, smartgarden) in addition to the",
    "existing .venv/bin/ forms; added secrets/ and *.pem to the Read deny list.",
    "The history and running-garden protections listed above are unchanged."
  ],

  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 30,

  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m unittest *)",
      "Bash(python -m unittest *)",
      "Bash(python3 scripts/*.py *)",
      "Bash(python scripts/*.py *)",
      "Bash(pip install *)",
      "Bash(smartgarden *)",

      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/mypy *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(.venv/bin/smartgarden *)",
      "Bash(python3 -m venv *)",
      "Bash(python3 scripts/gate.py*)",
      "Bash(python3 scripts/diff_gate.py*)",
      "Bash(PYTHONPATH=src .venv/bin/python *)",

      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b auto/*)",
      "Bash(git checkout -b fix/*)",
      "Bash(git checkout -b docs/*)",
      "Bash(git checkout -b chore/*)",
      "Bash(git switch -c auto/*)",
      "Bash(git switch -c fix/*)",
      "Bash(git switch -c docs/*)",
      "Bash(git switch -c chore/*)",
      "Bash(git switch auto/*)",
      "Bash(git switch main)",
      "Bash(git branch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git tag -a *)",
      "Bash(git revert *)",

      "Bash(git push -u origin auto/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin auto/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin --delete auto/*)",
      "Bash(git push origin layer-*)",
      "Bash(git push origin refs/tags/*)",

      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge * --squash *)",
      "Bash(gh pr merge --squash *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh issue create *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh release create layer-*)",
      "Bash(gh api repos/*)",

      "Bash(i2cdetect *)",
      "Bash(sqlite3 *)",
      "Bash(journalctl --user *)",
      "Bash(systemctl status *)",
      "Bash(systemctl --user status *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(uname *)",
      "Bash(vcgencmd *)",
      "Bash(df *)",
      "Bash(free *)"
    ],

    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",

      "Bash(systemctl start *)",
      "Bash(systemctl stop *)",
      "Bash(systemctl restart *)",
      "Bash(systemctl enable *)",
      "Bash(systemctl disable *)",
      "Bash(systemctl --user start *)",
      "Bash(systemctl --user stop *)",
      "Bash(systemctl --user restart *)",
      "Bash(systemctl daemon-reload *)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push origin main*)",
      "Bash(git push origin +*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push --mirror *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git clean *)",
      "Bash(git merge *)",

      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr review *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh workflow disable *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",

      "Bash(rm -rf *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(raspi-config *)",
      "Bash(gpioset *)",
      "Bash(pinctrl *)",

      "Edit(/.stage-b-complete)",

      "Read(.env)",
      "Read(secrets/**)",
      "Read(*.pem)"
    ]
  },

  "env": {
    "PYTHONPATH": "src"
  }
}
